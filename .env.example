# Per developer configuration of the pytest tests for the ExecutionPlatform

# 1. Copy this file to .env (gitignored)
# 2. Adapt at least EP_URL.
# 3. For usage see example/hello_world/test_hello_world.py
# The ep-configs your tests import are listed in pyproject.toml: under pythonpath in
# [tool.pytest] and, for code completion, under extraPaths in [tool.pyright].

# The following variables are used when the corresponding arguments of EP.fixture() are omitted in a test.

# The url pointing to an EP or Management Node.
EP_URL=user:password@my-ep

# The binary directory
EP_BINARY_DIR=build

# Debug mode for every pytest suite: Off, External or VSCode. Off when empty.
EP_DEBUGGING=Off
